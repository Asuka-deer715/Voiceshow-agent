LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_MODEL=deepseek-reasoner
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_ENABLE_TOOL_CALLING=0
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
PROMPT_INTENT_VERSION=v1
PROMPT_ANSWER_VERSION=v1
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=sqlite:///G:/ai-agent-show/voiceshop-ai/data/voiceshop.db
DATABASE_READ_URL=sqlite:///G:/ai-agent-show/voiceshop-ai/data/voiceshop.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_SLOW_QUERY_MS=200
